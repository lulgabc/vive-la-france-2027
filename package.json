{
  "name": "vive-la-france-2027",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm --filter @vlf/web dev",
    "dev:pipeline": "pnpm --filter @vlf/pipeline dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:migrate:local": "wrangler d1 migrations apply vlf-main --local --persist-to .wrangler/state --config apps/pipeline/wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply vlf-main --remote --config apps/pipeline/wrangler.jsonc",
    "db:seed:local": "wrangler d1 execute vlf-main --local --persist-to .wrangler/state --config apps/pipeline/wrangler.jsonc --file=packages/db/seed.sql",
    "db:seed:remote": "wrangler d1 execute vlf-main --remote --config apps/pipeline/wrangler.jsonc --file=packages/db/seed.sql"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "typescript": "^5.9.0",
    "wrangler": "^4.160.0"
  }
}
