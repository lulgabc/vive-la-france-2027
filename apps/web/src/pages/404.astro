---
import Base from '../layouts/Base.astro';
---

<Base lang="fr" title="404">
  <div class="container-page py-24">
    <div class="kicker">404</div>
    <h1 class="mt-2 font-display text-5xl">Page introuvable</h1>
    <p class="mt-3 text-muted">La page demandée n’existe pas ou a été déplacée.</p>
    <a href="/" class="mt-6 inline-flex border border-ink px-4 py-2 text-sm font-semibold hover:bg-ink hover:text-paper">Retour à l’accueil</a>
  </div>
</Base>
