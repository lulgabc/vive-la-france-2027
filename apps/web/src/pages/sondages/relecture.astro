---
import PollReview from '../../components/PollReview.svelte';
import { readConnectorStatus } from '../../lib/api';
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';

const db = (env as any).DB as D1Database | undefined;
const connectors = await readConnectorStatus(db);
const dateFmt = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'short', timeStyle: 'short' });
---

<Base lang="fr" active="polls">
  <section class="border-b border-rule">
    <div class="container-page py-8 md:py-10">
      <div class="kicker">Sondages / relecture</div>
      <h1 class="mt-2 font-display text-4xl md:text-5xl tracking-tight">File de relecture</h1>
      <p class="mt-3 max-w-2xl text-sm text-muted">
        Les PDF de la Commission des sondages sont parsés automatiquement, puis restent en brouillon jusqu’à validation humaine.
        Approuver un brouillon crée le sondage, agrège les moyennes et recalcule le score composite.
      </p>
    </div>
  </section>
  <section class="container-page py-6">
    <div class="border border-rule bg-white/30 p-4">
      <div class="flex items-end justify-between gap-3">
        <div>
          <div class="kicker">Connecteurs</div>
          <h2 class="mt-1 font-display text-2xl tracking-tight">Dernier succès par source</h2>
        </div>
        <span class="font-mono text-[10px] text-muted">{connectors.data.length} connecteurs</span>
      </div>
      <div class="mt-3 overflow-x-auto">
        <table class="w-full text-xs">
          <thead>
            <tr class="border-b border-rule text-left uppercase tracking-wider text-muted">
              <th class="py-2 pr-3 font-semibold">Connecteur</th>
              <th class="py-2 pr-3 font-semibold">Dernier succès</th>
              <th class="py-2 pr-3 font-semibold">Statut</th>
              <th class="py-2 pr-3 text-right font-semibold">Items</th>
              <th class="py-2 pr-3 text-right font-semibold">Erreurs</th>
              <th class="py-2 font-semibold">Détail</th>
            </tr>
          </thead>
          <tbody>
            {connectors.data.map((row: any) => (
              <tr class="border-b border-rule last:border-b-0">
                <td class="py-2 pr-3 font-mono font-semibold">{row.connector}</td>
                <td class="py-2 pr-3 text-muted">{row.last_finished ? dateFmt.format(new Date(row.last_finished)) : '—'}</td>
                <td class="py-2 pr-3">
                  <span class:list={['border px-1.5 py-0.5 font-mono text-[9px] uppercase', row.last_status === 'ok' ? 'border-ok/40 text-ok' : row.last_status === 'partial' ? 'border-amber/40 text-amber' : 'border-danger/40 text-danger']}>
                    {row.last_status ?? '—'}
                  </span>
                </td>
                <td class="py-2 pr-3 text-right font-mono">{row.last_items ?? 0}</td>
                <td class="py-2 pr-3 text-right font-mono">{row.last_errors ?? 0}</td>
                <td class="py-2 text-muted">{row.last_detail ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-4 border border-rule bg-white/30">
      <PollReview client:load />
    </div>
    <p class="mt-3 text-xs text-muted">
      Le token admin est stocké uniquement dans <code>sessionStorage</code> de cet onglet. En local, utilisez <code>dev-token</code>.
      Le pipeline doit être accessible sur <code>http://127.0.0.1:8787</code>, ou définir <code>PUBLIC_PIPELINE_URL</code>.
    </p>
  </section>
</Base>
