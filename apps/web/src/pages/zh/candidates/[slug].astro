---
import { candidateBySlug } from '@vlf/domain';
import CandidatePage from '../../../components/CandidatePage.astro';
import Base from '../../../layouts/Base.astro';

const { slug } = Astro.params;
const candidate = slug ? candidateBySlug(slug) : undefined;
if (!candidate) Astro.response.status = 404;
---

<Base lang="zh" active="candidates" title={candidate?.name_zh}>
  {candidate ? <CandidatePage lang="zh" slug={candidate.slug} /> : (
    <div class="container-page py-20">
      <h1 class="font-display text-3xl">404</h1>
      <p class="mt-2 text-muted">未找到候选人。</p>
    </div>
  )}
</Base>
