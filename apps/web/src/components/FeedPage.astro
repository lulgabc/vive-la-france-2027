---
import { TOPICS, partyById } from '@vlf/domain';
import { env } from 'cloudflare:workers';
import { readFeed, readMomentum, readSources } from '../lib/api';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const url = Astro.url;
const page = Math.max(1, Number(url.searchParams.get('page') ?? '1') || 1);
const source = url.searchParams.get('source') ?? '';
const topic = url.searchParams.get('topic') ?? '';
const q = url.searchParams.get('q') ?? '';
const all = url.searchParams.get('all') === '1';
const limit = 20;
const offset = (page - 1) * limit;

const db = (env as any).DB as D1Database | undefined;
const [feed, sources, momentum] = await Promise.all([
  readFeed(db, {
    source: source || undefined,
    topic: topic || undefined,
    q: q || undefined,
    limit,
    offset,
    electionOnly: !all,
  }),
  readSources(db),
  readMomentum(db),
]);

const totalPages = Math.max(1, Math.ceil(feed.total / limit));
const locale = lang === 'zh' ? 'zh-CN' : lang === 'en' ? 'en-GB' : 'fr-FR';
const dateFormat = new Intl.DateTimeFormat(locale, { day: '2-digit', month: 'short', year: 'numeric' });
const numberFormat = new Intl.NumberFormat(locale);

function topicLabel(id: string | null): string {
  if (!id) return '';
  const item = TOPICS.find((entry) => entry.id === id);
  return item ? item[lang] : id;
}

function pageUrl(target: number): string {
  const params = new URLSearchParams();
  if (source) params.set('source', source);
  if (topic) params.set('topic', topic);
  if (q) params.set('q', q);
  if (all) params.set('all', '1');
  params.set('page', String(target));
  return `${url.pathname}?${params.toString()}`;
}

function formatDate(value: string | null): string {
  if (!value) return '';
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? '' : dateFormat.format(date);
}
---

<section class="border-b border-rule">
  <div class="container-page py-8 md:py-12">
    <div class="kicker">{t('nav.feed')}</div>
    <h1 class="mt-2 font-display text-4xl md:text-5xl tracking-tight">{t('home.feed')}</h1>
    <p class="mt-3 text-sm text-muted max-w-2xl">
      {lang === 'fr'
        ? 'Articles politiques, sondages et signaux sociaux. Les contenus sont classés par thème et restent liés à leur source.'
        : lang === 'en'
          ? 'Political articles, polls and social signals. Content is classified by topic and always links back to its source.'
          : '政治文章、民调与社交信号。内容按议题分类，并始终链接回原始来源。'}
    </p>
    <p class="mt-2 text-xs text-muted">
      {feed.source === 'd1' ? `${numberFormat.format(feed.total)} ${t('feed.results')}` : t('feed.empty')}
      · {t('feed.window')}
    </p>
  </div>
</section>

<section class="container-page py-6 md:py-10 grid gap-8 lg:grid-cols-[1fr_18rem] items-start">
  <div>
    <form method="get" action={url.pathname} class="border border-rule bg-white/30 p-3 md:p-4 grid gap-3 md:grid-cols-[1fr_1fr_1.2fr_auto]">
      <label class="block text-xs">
        <span class="kicker">{t('feed.source')}</span>
        <select name="source" class="mt-1 w-full border border-rule-strong bg-paper px-2 py-2 text-sm">
          <option value="">{t('feed.allSources')}</option>
          {sources.map((item: any) => (
            <option value={item.id} selected={source === item.id}>{item.name}</option>
          ))}
        </select>
      </label>
      <label class="block text-xs">
        <span class="kicker">{t('feed.topic')}</span>
        <select name="topic" class="mt-1 w-full border border-rule-strong bg-paper px-2 py-2 text-sm">
          <option value="">{t('feed.allTopics')}</option>
          {TOPICS.map((item) => (
            <option value={item.id} selected={topic === item.id}>{item[lang]}</option>
          ))}
        </select>
      </label>
      <label class="block text-xs">
        <span class="kicker">{t('feed.search')}</span>
        <input name="q" value={q} class="mt-1 w-full border border-rule-strong bg-paper px-2 py-2 text-sm" placeholder="Marine Le Pen, retraites…" />
      </label>
      <div class="flex items-end gap-2">
        <button type="submit" class="bg-ink text-paper px-4 py-2 text-sm font-semibold hover:bg-accent transition-colors">{t('feed.apply')}</button>
        <a href={url.pathname} class="border border-rule-strong px-3 py-2 text-sm text-muted hover:border-ink">{t('feed.reset')}</a>
      </div>
      <label class="flex items-center gap-2 text-xs text-muted md:col-span-4">
        <input type="checkbox" name="all" value="1" checked={all} />
        {t('feed.allNews')}
      </label>
    </form>

    {feed.data.length === 0 ? (
      <div class="mt-4 border border-rule bg-white/30 p-8 text-center text-sm text-muted">
        {t('feed.empty')}
      </div>
    ) : (
      <div class="mt-4 border border-rule bg-white/30">
        {feed.data.map((article: any) => (
          <article class="p-4 border-b border-rule last:border-b-0">
            <div class="flex flex-wrap items-center gap-2 text-xs text-muted">
              <span class="font-semibold text-ink">{article.source_name}</span>
              <span>·</span>
              <time datetime={article.published_at ?? undefined}>{formatDate(article.published_at)}</time>
              {article.topic && (
                <>
                  <span>·</span>
                  <span class="border border-rule px-1.5 py-0.5">{topicLabel(article.topic)}</span>
                </>
              )}
            </div>
            <h2 class="mt-2 font-display text-xl leading-snug">
              <a href={article.canonical_url} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
                {article.title}
              </a>
            </h2>
            {article.excerpt && <p class="mt-1.5 text-sm text-muted leading-relaxed line-clamp-3">{article.excerpt}</p>}
            <a href={article.canonical_url} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-xs font-semibold underline hover:text-accent">
              {t('feed.readSource')} ↗
            </a>
          </article>
        ))}
      </div>
    )}

    {totalPages > 1 && (
      <nav class="mt-4 flex items-center justify-between text-sm" aria-label="Pagination">
        {page > 1 ? <a href={pageUrl(page - 1)} class="border border-rule px-3 py-1.5 hover:border-ink">← {t('feed.prev')}</a> : <span></span>}
        <span class="text-muted">{t('feed.page')} {page} / {totalPages}</span>
        {page < totalPages ? <a href={pageUrl(page + 1)} class="border border-rule px-3 py-1.5 hover:border-ink">{t('feed.next')} →</a> : <span></span>}
      </nav>
    )}
  </div>

  <aside class="border border-rule bg-white/30 p-4 lg:sticky lg:top-28">
    <div class="kicker">{t('feed.momentum')}</div>
    <p class="mt-1 text-xs text-muted">{t('feed.mentions')}{momentum.as_of ? ` · ${momentum.as_of}` : ''}</p>
    {momentum.data.length === 0 ? (
      <p class="mt-3 text-xs text-muted">
        {lang === 'fr'
          ? 'Le calcul de momentum sera disponible après le premier passage du pipeline.'
          : lang === 'en'
            ? 'Momentum will appear after the pipeline runs.'
            : '数据管线运行后，媒体热度会显示在这里。'}
      </p>
    ) : (
      <ol class="mt-3 space-y-2">
        {momentum.data.map((item: any, index: number) => {
          const party = item.party_id ? partyById(item.party_id) : undefined;
          return (
            <li class="flex items-center justify-between gap-2 text-sm">
              <span class="flex items-center gap-2 min-w-0">
                <span class="text-xs text-muted tabular-nums">{index + 1}</span>
                <span class="inline-block h-2 w-2 rounded-full shrink-0" style={`background:${party?.color ?? '#9ca3af'}`}></span>
                <span class="truncate">{item.name}</span>
              </span>
              <span class="tabular-nums font-semibold">{item.mentions}</span>
            </li>
          );
        })}
      </ol>
    )}
  </aside>
</section>
