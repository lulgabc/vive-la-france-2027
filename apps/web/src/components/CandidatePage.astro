---
import {
  candidateBySlug,
  candidates,
  demoScore,
  formatPercent,
  localizedBio,
  localizedName,
  partyById,
} from '@vlf/domain';
import { env } from 'cloudflare:workers';
import { readPollAverages } from '../lib/api';
import { candidateRoute, route } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import Sparkline from './Sparkline.astro';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const candidate = candidateBySlug(slug);
if (!candidate) throw new Error(`Unknown candidate: ${slug}`);
const t = useTranslations(lang);

const party = partyById(candidate.party_id);
const score = demoScore(candidate.id);
const pollData = await readPollAverages((env as any).DB as D1Database | undefined);
const poll = pollData.data.find((row: any) => row.candidate_id === candidate.id);
const pollValue = poll?.avg ?? score?.poll_avg ?? 0;
const pollCount = poll?.polls ?? 0;
const others = candidates
  .filter((item) => item.id !== candidate.id && item.status !== 'withdrawn')
  .slice(0, 6);

const statusKey =
  candidate.status === 'declared'
    ? 'status.declared'
    : candidate.status === 'likely'
      ? 'status.likely'
      : candidate.status === 'potential'
        ? 'status.potential'
        : 'status.withdrawn';

const components = score
  ? [
      { key: 'score.poll', value: pollValue, display: formatPercent(pollValue), bar: Math.min(100, (pollValue / 40) * 100), color: '#0b3d91' },
      { key: 'score.market', value: score.market_prob, display: `${Math.round(score.market_prob * 100)} %`, bar: Math.min(100, score.market_prob * 100), color: '#2e8b57' },
      { key: 'score.media', value: score.share_of_voice, display: `${Math.round(score.share_of_voice * 100)} %`, bar: Math.min(100, score.share_of_voice * 300), color: '#c8102e' },
      { key: 'score.social', value: score.social_attention, display: `${Math.round(score.social_attention * 100)} %`, bar: Math.min(100, score.social_attention * 300), color: '#6a0dad' },
      { key: 'score.elite', value: score.elite, display: `${Math.round(score.elite * 100)} %`, bar: Math.min(100, score.elite * 100), color: '#f28c28' },
    ]
  : [];
---

<section class="border-b border-rule">
  <div class="container-page py-8 md:py-12">
    <a href={route('candidates', lang)} class="text-xs font-semibold text-muted hover:text-accent">← {t('nav.candidates')}</a>
    <div class="mt-4 grid gap-8 lg:grid-cols-[1.5fr_0.8fr] items-start">
      <div>
        <div class="flex items-center gap-4">
          <img src={candidate.avatar} alt="" class="h-20 w-20 md:h-24 md:w-24 rounded-full border border-rule object-cover bg-paper-deep" />
          <div>
            <div class="flex items-center gap-2 text-sm">
              <span class="inline-block h-3 w-3 rounded-full" style={`background:${party?.color ?? '#9ca3af'}`}></span>
              <span class="font-semibold" style={`color:${party?.color ?? '#6b6b6b'}`}>{party?.name ?? candidate.party_id}</span>
              <span class="text-muted">·</span>
              <span class="text-muted">{t(statusKey as any)}</span>
            </div>
            <h1 class="mt-1 font-display text-4xl md:text-6xl tracking-tight">{localizedName(candidate, lang)}</h1>
          </div>
        </div>
        <p class="mt-4 text-base text-muted leading-relaxed max-w-2xl">{localizedBio(candidate, lang)}</p>
        {candidate.avatar_source && (
          <p class="mt-2 text-[11px] text-muted">
            Photo : <a href={candidate.avatar_source} target="_blank" rel="noopener noreferrer" class="underline hover:text-accent">{candidate.avatar_credit}</a> · Wikimedia Commons
          </p>
        )}
        {candidate.declared_at && (
          <p class="mt-3 text-xs text-muted">{t('status.declared')} · {candidate.declared_at}</p>
        )}
      </div>

      <aside class="border border-rule bg-white/50 p-5">
        <div class="kicker">{t('score.composite')}</div>
        <div class="mt-1 flex items-baseline gap-2">
          <span class="font-display text-6xl leading-none">{score ? Math.round(score.composite) : '—'}</span>
          <span class="text-muted text-sm">/ 100</span>
        </div>
        <div class="mt-2 text-xs text-muted">{t('score.asOf')} {score ? '2026-11-10' : '—'} · {t('common.demo')}</div>
        {score && (
          <div class="mt-4">
            <div class="text-xs text-muted mb-1">{t('score.trend')}</div>
            <Sparkline values={score.trend} color={party?.color ?? '#0b3d91'} width={260} height={48} />
          </div>
        )}
        <div class="mt-4 pt-3 border-t border-rule text-xs text-muted">
          {t('score.confidence')} : <span class="font-semibold text-ink">{score?.confidence ?? '—'}</span>
        </div>
      </aside>
    </div>
  </div>
</section>

<section class="container-page py-8 md:py-12 grid gap-8 lg:grid-cols-[1.4fr_0.8fr]">
  <div>
    <div class="kicker">{t('candidate.scoreBreakdown')}</div>
    <h2 class="mt-1 font-display text-2xl">{t('candidate.scoreBreakdown')}</h2>
    <div class="mt-4 border border-rule bg-white/30 p-4 md:p-5">
      {components.map((component) => (
        <div class="mb-4 last:mb-0">
          <div class="flex items-center justify-between text-sm">
            <span class="font-semibold">{t(component.key as any)}</span>
            <span class="tabular-nums">{component.display}</span>
          </div>
          <div class="mt-1.5 h-2 bg-paper-deep rounded-full overflow-hidden">
            <div class="h-full rounded-full" style={`width:${component.bar}%; background:${component.color}`}></div>
          </div>
        </div>
      ))}
    </div>
    <p class="mt-3 text-xs text-muted">{t('home.scoreboardNote')}</p>
    {pollCount > 0 && (
      <p class="mt-1 text-xs text-muted">{t('score.poll')} · n={pollCount} · {poll?.last_poll_at}</p>
    )}
  </div>

  <div>
    <div class="kicker">{t('candidate.other')}</div>
    <h2 class="mt-1 font-display text-2xl">{t('candidate.other')}</h2>
    <div class="mt-4 border border-rule bg-white/30">
      {others.map((other) => {
        const otherParty = partyById(other.party_id);
        return (
          <a href={candidateRoute(other.slug, lang)} class="flex items-center justify-between gap-3 p-3 border-b border-rule last:border-b-0 hover:bg-white/50 transition-colors">
            <span class="flex items-center gap-2 text-sm">
              <span class="inline-block h-2 w-2 rounded-full" style={`background:${otherParty?.color ?? '#9ca3af'}`}></span>
              {localizedName(other, lang)}
            </span>
            <span class="text-xs text-muted">{otherParty?.short_name}</span>
          </a>
        );
      })}
    </div>
  </div>
</section>
