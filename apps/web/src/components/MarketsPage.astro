---
import { env } from 'cloudflare:workers';
import { readMarkets } from '../lib/api';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const db = (env as any).DB as D1Database | undefined;
const real = await readMarkets(db);
const selectedPlatform = Astro.url.searchParams.get('platform') ?? 'all';
const platforms = real.platforms ?? [];
const rows = selectedPlatform === 'all'
  ? real.data
  : real.data.filter((market: any) => market.platform === selectedPlatform);

const copy = {
  fr: {
    source: 'Polymarket via le miroir public Sondax. Les ondes Kalshi et Metaculus sont branchées mais ne proposent pas encore de marché France 2027.',
    all: 'Toutes',
    probability: 'Probabilité implicite',
    liquidity: 'Liquidité',
    change7: '7 j',
    change30: '30 j',
    history: 'Historique',
    empty: 'Aucun marché pour cette plateforme.',
    platformNote: 'Les probabilités sont des prix de marché, pas des intentions de vote. Elles peuvent être peu liquides et ne constituent pas une prévision.',
    stats: 'marchés suivis',
    avg: 'probabilité moyenne',
    top: 'marché le plus probable',
  },
  en: {
    source: 'Polymarket via the public Sondax mirror. Kalshi and Metaculus connectors are wired but do not yet expose a France 2027 market.',
    all: 'All',
    probability: 'Implied probability',
    liquidity: 'Liquidity',
    change7: '7d',
    change30: '30d',
    history: 'History',
    empty: 'No market for this platform.',
    platformNote: 'Probabilities are market prices, not voting intentions. They can be illiquid and are not a forecast.',
    stats: 'markets tracked',
    avg: 'average probability',
    top: 'most likely market',
  },
  zh: {
    source: 'Polymarket 数据经 Sondax 公共镜像。Kalshi 与 Metaculus 连接器已接好，但尚无法国 2027 市场。',
    all: '全部',
    probability: '隐含概率',
    liquidity: '流动性',
    change7: '7 天',
    change30: '30 天',
    history: '历史',
    empty: '该平台暂无市场。',
    platformNote: '概率是市场价格，不是投票意向；流动性可能不足，也不构成预测。',
    stats: '个市场',
    avg: '平均概率',
    top: '最高概率市场',
  },
}[lang];

const pct = (value: unknown, digits = 0) =>
  typeof value === 'number' ? `${(value * 100).toFixed(digits).replace('.', ',')} %` : '—';
const signed = (value: unknown) => {
  if (typeof value !== 'number') return '—';
  const points = value * 100;
  const sign = points > 0 ? '+' : '';
  return `${sign}${points.toFixed(1).replace('.', ',')} pts`;
};

function sparkline(points: Array<{ ts: string; prob: number }>, width = 180, height = 36): string {
  if (points.length < 2) return '';
  const values = points.map((point) => point.prob);
  const min = Math.min(...values);
  const max = Math.max(...values);
  const span = max - min || 0.01;
  return values
    .map((value, index) => {
      const x = (index / (values.length - 1)) * width;
      const y = height - 3 - ((value - min) / span) * (height - 6);
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(' ');
}

const avg = rows.length
  ? rows.reduce((sum: number, row: any) => sum + (row.implied_prob ?? 0), 0) / rows.length
  : null;
const top = rows[0];
const platformCounts = platforms.map((platform: string) => ({
  platform,
  count: real.data.filter((market: any) => market.platform === platform).length,
}));
---

<section class="border-b border-rule">
  <div class="container-page py-8 md:py-12">
    <div class="kicker">{t('nav.markets')}</div>
    <h1 class="mt-2 font-display text-4xl md:text-5xl tracking-tight">{t('markets.title')}</h1>
    <p class="mt-3 text-sm text-muted max-w-3xl">{t('markets.subtitle')}</p>
    <p class="mt-2 text-xs text-muted max-w-3xl">{copy.source}</p>
  </div>
</section>

<section class="container-page py-8 md:py-12">
  <div class="grid gap-3 sm:grid-cols-3">
    <div class="border border-rule bg-white/30 p-4">
      <div class="kicker">{copy.stats}</div>
      <div class="mt-1 font-display text-3xl font-semibold tabular-nums">{real.data.length}</div>
      <div class="mt-1 font-mono text-[10px] text-muted">{platformCounts.map((item: any) => `${item.platform} ${item.count}`).join(' · ')}</div>
    </div>
    <div class="border border-rule bg-white/30 p-4">
      <div class="kicker">{copy.avg}</div>
      <div class="mt-1 font-display text-3xl font-semibold tabular-nums">{pct(avg, 1)}</div>
      <div class="mt-1 font-mono text-[10px] text-muted">{copy.probability}</div>
    </div>
    <div class="border border-rule bg-white/30 p-4">
      <div class="kicker">{copy.top}</div>
      <div class="mt-1 font-display text-3xl font-semibold tabular-nums">{top ? pct(top.implied_prob, 0) : '—'}</div>
      <div class="mt-1 truncate font-mono text-[10px] text-muted">{top?.question ?? '—'}</div>
    </div>
  </div>

  <div class="mt-6 flex flex-wrap items-center gap-2">
    <a
      href={Astro.url.pathname}
      class:list={['border px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.12em]', selectedPlatform === 'all' ? 'border-ink bg-ink text-paper' : 'border-rule text-muted hover:border-ink hover:text-ink']}
    >{copy.all}</a>
    {platforms.map((platform: string) => (
      <a
        href={`${Astro.url.pathname}?platform=${platform}`}
        class:list={['border px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.12em]', selectedPlatform === platform ? 'border-ink bg-ink text-paper' : 'border-rule text-muted hover:border-ink hover:text-ink']}
      >{platform}</a>
    ))}
  </div>

  <div class="mt-4 grid gap-3">
    {rows.map((market: any) => {
      const points = sparkline(market.history ?? []);
      return (
        <a
          href={market.source_url ?? '#'}
          target="_blank"
          rel="noopener noreferrer"
          class="border border-rule-strong bg-white/30 p-4 hover:border-ink transition-colors"
        >
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <span class="kicker">{market.platform}</span>
                <span class="font-mono text-[9px] uppercase tracking-[0.1em] text-muted">{market.market_key?.split(':').slice(-2).join(' / ')}</span>
              </div>
              <div class="mt-1 text-sm">{market.question}</div>
            </div>
            <div class="text-right">
              <div class="font-display text-2xl font-semibold tabular-nums">{pct(market.implied_prob, 0)}</div>
              <div class="font-mono text-[10px] text-muted">
                {copy.change7} {signed(market.change_7d)} · {copy.change30} {signed(market.change_30d)}
              </div>
            </div>
          </div>
          <div class="mt-3 flex items-end justify-between gap-4">
            <div class="text-xs text-muted">
              {copy.liquidity} : {market.liquidity ?? '—'} · {market.ts ?? ''}
            </div>
            {points ? (
              <svg viewBox="0 0 180 36" class="h-9 w-[180px] shrink-0" role="img" aria-label={copy.history}>
                <polyline fill="none" stroke="currentColor" stroke-width="1.6" points={points} class="text-accent" />
              </svg>
            ) : (
              <span class="font-mono text-[9px] text-muted">{copy.history} —</span>
            )}
          </div>
        </a>
      );
    })}
    {rows.length === 0 && <p class="text-sm text-muted">{copy.empty}</p>}
  </div>

  <p class="mt-4 max-w-3xl text-xs text-muted">{copy.platformNote}</p>
</section>
