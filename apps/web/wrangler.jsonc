{
  "name": "vlf-web",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    { "binding": "SESSION", "id": "REPLACE_WITH_SESSION_KV_ID" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vlf-main",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "../../packages/db/migrations"
    }
  ]
}
