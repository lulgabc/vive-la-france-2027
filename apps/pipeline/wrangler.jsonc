{
  "name": "vlf-pipeline",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *", "*/15 * * * *", "0 * * * *", "0 6 * * *", "0 */2 * * *"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "LIVE_HUB", "class_name": "LiveHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LiveHub"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vlf-main",
      "database_id": "57a6f4fb-e5a6-4b8a-b3e4-b372d7568713",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "services": [
    { "binding": "WEB", "service": "vlf-web" }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "b3cb45bf28fd42d38b1995230d387dd8"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INGEST_QUEUE",
        "queue": "vlf-ingest"
      }
    ],
    "consumers": [
      {
        "queue": "vlf-ingest",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "vlf-ingest-dlq"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "SITE_URL": "https://vlf-web.ainet-netbook.workers.dev",
    "TYPESAFE_MODEL": "jev-latest",
    "JEV_ELECTION_THRESHOLD": "0.4",
    "X_MONTHLY_READ_CAP": "4000"
  }
}
